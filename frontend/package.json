{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "type-check": "tsc --noEmit",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "depcheck": "depcheck --ignore-bin-package --ignores='@tailwindcss/postcss,@types/node,@types/react-dom,prettier-plugin-tailwindcss,tailwindcss'",
    "ncu": "ncu",
    "ncu:upgrade": "ncu -u"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "npm-check-updates": "^19.4.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "tsc-files": "^1.1.4",
    "typescript": "^5"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  }
}
